# Copy this file to .env and fill in your two keys. Never commit .env.

# Nebius Token Factory: https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=
# Global endpoint. If your keys are regional, use https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily: https://app.tavily.com -> API keys (free tier works)
TAVILY_API_KEY=

# The three NVIDIA Nemotron models. Run `python scripts/doctor.py` to confirm the exact IDs on your account.
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b
MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional tuning
# CLAIM_CONCURRENCY=4
# ESCALATE_BELOW_CONFIDENCE=0.75
# MAX_CLAIMS=30
# LIVE_RUNS_PER_HOUR=12
# LIVE_RUNS_PER_DAY=300
# RECEIPTS_MOCK=1        # simulated mode for UI work without keys
